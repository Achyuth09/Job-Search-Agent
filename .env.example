# Private server secrets — do NOT prefix with VITE_.
# VITE_ values are baked into the browser bundle.

# Slack Incoming Webhook (Sensitive / Secret)
# Create it on #JONSEARCHAUTO: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Slack channel name (safe as public Config — not a secret)
SLACK_CHANNEL=JONSEARCHAUTO

# Optional. Enables LinkedIn, Indeed, Glassdoor, ZipRecruiter, and Google Jobs.
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Sensitive / Secret — never use VITE_
RAPIDAPI_KEY=
